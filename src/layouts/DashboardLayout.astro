---
import "../styles/globals.css";
import { APP_NAME } from "@/lib/constants";
import AppLogo from "@/components/AppLogo.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import type { Session } from "@/lib/auth";

interface Props {
  title?: string;
  session: Session;
}

const { title, session } = Astro.props;
const pageTitle = title ? `${title} | ${APP_NAME}` : APP_NAME;
const pathname = Astro.url.pathname;

const navItems = [
  { href: "/dashboard", label: "Overview", icon: "home" },
  { href: "/api/billing/portal", label: "Billing", icon: "billing", external: true },
  { href: "/dashboard/settings", label: "Settings", icon: "settings" },
];

const icons: Record<string, string> = {
  home: "M2.25 12l8.954-8.955a1.126 1.126 0 011.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25",
  billing: "M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z",
  settings: "M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z M15 12a3 3 0 11-6 0 3 3 0 016 0z",
};

function isActive(href: string, external?: boolean) {
  if (external) return false;
  if (href === "/dashboard") return pathname === "/dashboard" || pathname === "/dashboard/";
  return pathname.startsWith(href);
}
---

<!doctype html>
<html lang="en" class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>:root { --font-inter: 'Inter', system-ui, sans-serif; }</style>
    <script is:inline>
      (function(){try{var t=localStorage.getItem("theme");var d=document.documentElement;d.classList.remove("light","dark");if(t==="dark"||t==="light"){d.classList.add(t)}else{d.classList.add(window.matchMedia("(prefers-color-scheme:dark)").matches?"dark":"light")}}catch(e){}})()
    </script>
  </head>
  <body class="antialiased">
    <div class="flex h-screen">
      <!-- Desktop sidebar -->
      <aside class="hidden lg:flex inset-y-0 left-0 w-56 shrink-0 flex-col border-r border-[var(--border)] bg-[var(--background)]">
        <div class="flex h-14 items-center border-b border-[var(--border)] px-5">
          <a href="/"><AppLogo /></a>
        </div>
        <nav class="p-2 space-y-0.5">
          {navItems.map((item) => {
            const active = isActive(item.href, item.external);
            const Tag = item.external ? "a" : "a";
            return (
              <a
                href={item.href}
                class:list={[
                  "flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm transition-colors",
                  active
                    ? "bg-[var(--surface)] text-[var(--foreground)] font-medium"
                    : "text-[var(--muted)] hover:text-[var(--foreground)] hover:bg-[var(--surface)]",
                ]}
              >
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d={icons[item.icon]} />
                </svg>
                {item.label}
              </a>
            );
          })}
        </nav>
      </aside>

      <div class="flex flex-1 flex-col overflow-hidden">
        <!-- Header -->
        <header class="flex h-14 items-center justify-between border-b border-[var(--border)] px-4 sm:px-6">
          <!-- Mobile: logo -->
          <div class="flex items-center gap-2 lg:hidden">
            <a href="/"><AppLogo /></a>
          </div>
          <div class="hidden lg:block"></div>

          <!-- Right side -->
          <div class="flex items-center gap-3">
            <span class="hidden text-xs text-[var(--muted)] lg:block">{session.email}</span>
            <ThemeToggle />
            <!-- User avatar -->
            <a href="/api/auth/logout" class="flex h-8 w-8 items-center justify-center rounded-full bg-[var(--accent)]/10 text-xs font-semibold text-[var(--accent)]" title="Sign out">
              {session.name?.[0]?.toUpperCase() || session.email?.[0]?.toUpperCase() || "?"}
            </a>
          </div>
        </header>

        <!-- Mobile nav -->
        <div class="flex border-b border-[var(--border)] px-4 gap-1 lg:hidden">
          {navItems.map((item) => {
            const active = isActive(item.href, item.external);
            return (
              <a
                href={item.href}
                class:list={[
                  "flex items-center gap-1.5 px-3 py-2.5 text-sm transition-colors border-b-2 -mb-px",
                  active
                    ? "border-[var(--foreground)] text-[var(--foreground)] font-medium"
                    : "border-transparent text-[var(--muted)] hover:text-[var(--foreground)]",
                ]}
              >
                {item.label}
              </a>
            );
          })}
        </div>

        <main id="main-content" class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
