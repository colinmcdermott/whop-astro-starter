---
import { APP_NAME, APP_DESCRIPTION } from "@/lib/constants";
---

<section class="py-24 px-6">
  <div class="max-w-3xl mx-auto text-center">
    <h1 class="text-5xl font-bold tracking-tight mb-4 animate-[slide-up_0.5s_ease-out]">
      {APP_NAME}
    </h1>
    <p class="text-xl text-[var(--muted)] mb-8 animate-[slide-up_0.5s_ease-out_0.1s] opacity-0 [animation-fill-mode:forwards]">
      {APP_DESCRIPTION}
    </p>
    <div class="flex items-center justify-center gap-4 animate-[slide-up_0.5s_ease-out_0.2s] opacity-0 [animation-fill-mode:forwards]">
      <a href="/api/auth/login" class="bg-[var(--accent)] text-[var(--accent-foreground)] px-6 py-3 rounded-lg font-medium hover:opacity-90 transition-opacity">
        Get Started
      </a>
      <a href="/pricing" class="border border-[var(--border)] px-6 py-3 rounded-lg font-medium hover:bg-[var(--surface)] transition-colors">
        View Pricing
      </a>
    </div>
  </div>
</section>
