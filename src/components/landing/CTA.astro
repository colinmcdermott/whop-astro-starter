---
import { APP_NAME } from "@/lib/constants";
---

<section class="py-24 px-6 border-t border-[var(--border)]">
  <div class="max-w-2xl mx-auto text-center">
    <h2 class="text-3xl font-bold mb-4">Ready to get started?</h2>
    <p class="text-[var(--muted)] mb-8">
      Join {APP_NAME} today and start building your SaaS.
    </p>
    <a href="/api/auth/login" class="inline-block bg-[var(--accent)] text-[var(--accent-foreground)] px-8 py-3 rounded-lg font-medium hover:opacity-90 transition-opacity">
      Sign up free
    </a>
  </div>
</section>
