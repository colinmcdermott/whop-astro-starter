---
import Layout from "@/layouts/Layout.astro";
import { APP_NAME } from "@/lib/constants";

export const prerender = true;
---

<Layout title="Login">
  <div class="max-w-sm mx-auto px-6 py-32 text-center">
    <h1 class="text-2xl font-semibold mb-2">Sign in to {APP_NAME}</h1>
    <p class="text-[var(--muted)] mb-8">Continue with your Whop account</p>
    <a href="/api/auth/login" class="inline-block bg-[var(--foreground)] text-[var(--background)] px-8 py-3 rounded-lg font-medium hover:opacity-90 transition-opacity">
      Sign in with Whop
    </a>
  </div>
</Layout>
