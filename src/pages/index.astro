---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/landing/Header.astro";
import Hero from "@/components/landing/Hero.astro";
import Features from "@/components/landing/Features.astro";
import Testimonials from "@/components/landing/Testimonials.astro";
import PricingCards from "@/components/landing/PricingCards.astro";
import CTA from "@/components/landing/CTA.astro";
import Footer from "@/components/landing/Footer.astro";

export const prerender = true;
---

<Layout>
  <div class="flex min-h-screen flex-col">
    <Header />
    <main id="main-content" class="flex-1">
      <Hero />
      <Features />
      <Testimonials />

      <!-- Pricing section -->
      <section>
        <div class="mx-auto max-w-5xl px-4 py-24 sm:px-6">
          <div class="text-center mb-16">
            <h2 class="text-2xl font-semibold tracking-tight text-balance sm:text-3xl">
              Simple, transparent pricing
            </h2>
            <p class="mt-3 text-sm text-[var(--muted)]">
              Start free. Upgrade when you're ready.
            </p>
          </div>
          <PricingCards />
        </div>
      </section>

      <CTA />
    </main>
    <Footer />
  </div>
</Layout>
