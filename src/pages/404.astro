---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Not Found">
  <div class="flex min-h-screen items-center justify-center px-4">
    <div class="w-full max-w-xs text-center">
      <p class="text-5xl font-semibold tracking-tight text-[var(--muted)]">404</p>

      <h1 class="mt-3 text-sm font-semibold">Page not found</h1>
      <p class="mt-1 text-xs text-[var(--muted)]">
        The page you're looking for doesn't exist or has been moved.
      </p>

      <div class="mt-6 flex flex-col gap-2">
        <a
          href="/"
          class="rounded-lg bg-[var(--accent)] px-4 py-2 text-sm font-medium text-[var(--accent-foreground)] transition-opacity hover:opacity-80"
        >
          Back to Home
        </a>
        <a
          href="/dashboard"
          class="rounded-lg border border-[var(--border)] px-4 py-2 text-sm font-medium transition-colors hover:bg-[var(--surface)]"
        >
          Go to Dashboard
        </a>
      </div>
    </div>
  </div>
</Layout>
