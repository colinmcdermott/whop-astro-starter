---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/landing/Header.astro";
import PricingCards from "@/components/landing/PricingCards.astro";
import Footer from "@/components/landing/Footer.astro";

export const prerender = true;
---

<Layout title="Pricing">
  <div class="flex min-h-screen flex-col">
    <Header />
    <main id="main-content" class="flex-1">
      <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-24">
        <div class="text-center mb-12">
          <h1 class="text-2xl font-semibold tracking-tight text-balance sm:text-3xl">
            Pricing
          </h1>
          <p class="mt-2 text-sm text-[var(--muted)]">
            Start free. Upgrade when you're ready. Cancel anytime.
          </p>
        </div>
        <PricingCards />
      </section>
    </main>
    <Footer />
  </div>
</Layout>
