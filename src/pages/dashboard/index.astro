---
import Layout from "@/layouts/Layout.astro";
import { getSession } from "@/lib/auth";

export const prerender = false;

const session = await getSession(Astro.cookies);
if (!session) {
  return Astro.redirect("/login");
}
---

<Layout title="Dashboard">
  <div style="max-width: 800px; margin: 0 auto; padding: 48px 24px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 48px;">
      <h1 style="font-size: 24px; font-weight: 600;">Dashboard</h1>
      <div style="display: flex; align-items: center; gap: 16px;">
        <span style="font-size: 14px; color: #71717a;">{session.email}</span>
        <a href="/api/auth/logout" style="font-size: 14px; color: #ef4444; text-decoration: none;">Sign out</a>
      </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 32px;">
      <div style="background: white; border: 1px solid #e4e4e7; border-radius: 12px; padding: 24px;">
        <p style="font-size: 12px; color: #71717a; text-transform: uppercase; margin-bottom: 4px;">Plan</p>
        <p style="font-size: 24px; font-weight: 600; text-transform: capitalize;">{session.plan}</p>
      </div>
      <div style="background: white; border: 1px solid #e4e4e7; border-radius: 12px; padding: 24px;">
        <p style="font-size: 12px; color: #71717a; text-transform: uppercase; margin-bottom: 4px;">Name</p>
        <p style="font-size: 24px; font-weight: 600;">{session.name || "—"}</p>
      </div>
      <div style="background: white; border: 1px solid #e4e4e7; border-radius: 12px; padding: 24px;">
        <p style="font-size: 12px; color: #71717a; text-transform: uppercase; margin-bottom: 4px;">Role</p>
        <p style="font-size: 24px; font-weight: 600;">{session.isAdmin ? "Admin" : "Member"}</p>
      </div>
    </div>

    <div style="background: white; border: 1px solid #e4e4e7; border-radius: 12px; padding: 24px;">
      <h2 style="font-size: 16px; font-weight: 600; margin-bottom: 16px;">Your app goes here</h2>
      <p style="font-size: 14px; color: #71717a; line-height: 1.6;">
        This template uses <a href="https://www.npmjs.com/package/whop-kit">whop-kit</a> for authentication,
        session management, and subscription handling — the same library as the Next.js starter.
        Build your Astro app on top of it.
      </p>
    </div>
  </div>
</Layout>
