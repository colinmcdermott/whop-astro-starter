---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import { getSession } from "@/lib/auth";
import { getPlansConfig } from "@/lib/config";
import { DEFAULT_PLAN, PLAN_KEYS, PLAN_METADATA } from "@/lib/constants";
import type { PlanKey } from "@/lib/constants";

export const prerender = false;

const session = await getSession(Astro.cookies);
if (!session) {
  return Astro.redirect("/login");
}

const plans = getPlansConfig();
const planConfig = plans[session.plan] ?? plans[DEFAULT_PLAN];
const nextPlanKey = PLAN_KEYS[PLAN_KEYS.indexOf(session.plan) + 1] as PlanKey | undefined;
---

<DashboardLayout title="Dashboard" session={session}>
  <div class="mx-auto max-w-4xl space-y-6">
    <!-- Welcome -->
    <div class="animate-slide-up">
      <h1 class="text-lg font-semibold tracking-tight">
        Welcome back{session.name ? `, ${session.name}` : ""}
      </h1>
      <p class="mt-0.5 text-sm text-[var(--muted)]">
        Here's an overview of your account.
      </p>
    </div>

    <!-- Stats -->
    <div class="animate-slide-up delay-100 grid gap-px overflow-hidden rounded-xl border border-[var(--border)] bg-[var(--border)] sm:grid-cols-3">
      <div class="bg-[var(--card)] p-5">
        <p class="text-xs text-[var(--muted)]">Current Plan</p>
        <p class="mt-1 text-xl font-semibold tracking-tight capitalize">{planConfig.name}</p>
      </div>
      <div class="bg-[var(--card)] p-5">
        <p class="text-xs text-[var(--muted)]">Projects</p>
        <p class="mt-1 text-xl font-semibold tracking-tight" style="font-variant-numeric: tabular-nums">0 / 3</p>
      </div>
      <div class="bg-[var(--card)] p-5">
        <p class="text-xs text-[var(--muted)]">Storage</p>
        <p class="mt-1 text-xl font-semibold tracking-tight" style="font-variant-numeric: tabular-nums">0 GB</p>
      </div>
    </div>

    <!-- Upgrade banner for free users -->
    {session.plan === DEFAULT_PLAN && (
      <div class="animate-slide-up delay-200 rounded-xl border border-[var(--accent)]/20 bg-[var(--accent)]/5 p-5">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h3 class="text-sm font-semibold">Upgrade your plan</h3>
            <p class="mt-1 text-xs text-[var(--muted)]">
              Get more projects, priority support, and advanced features.
            </p>
          </div>
          <a href="/pricing" class="shrink-0 rounded-lg bg-[var(--accent)] px-3 py-1.5 text-xs font-medium text-[var(--accent-foreground)] transition-opacity hover:opacity-80">
            View Plans
          </a>
        </div>
      </div>
    )}

    <!-- Plan features -->
    <div class="animate-slide-up delay-200 rounded-xl border border-[var(--border)] bg-[var(--card)] p-5">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h3 class="text-sm font-semibold">{planConfig.name} Plan</h3>
          <p class="mt-0.5 text-xs text-[var(--muted)]">{planConfig.description}</p>
        </div>
        {nextPlanKey && (
          <a href="/pricing" class="shrink-0 rounded-lg border border-[var(--border)] px-3 py-1.5 text-xs font-medium transition-colors hover:bg-[var(--surface)]">
            View Plans
          </a>
        )}
      </div>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
        {planConfig.features.map((feature) => (
          <li class="flex items-start gap-2 text-xs text-[var(--muted)]">
            <svg class="h-3.5 w-3.5 text-emerald-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span>{feature}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Getting started -->
    <div class="animate-slide-up delay-300 rounded-xl border border-[var(--border)] bg-[var(--card)] p-6">
      <h2 class="text-sm font-semibold">Get started</h2>
      <p class="mt-1 text-xs text-[var(--muted)] leading-relaxed">
        Replace this with your product. Auth, payments, and webhooks are ready.
      </p>

      <div class="mt-5 space-y-2.5">
        {[
          { n: 1, t: "Customize this dashboard" },
          { n: 2, t: "Set up your Whop plans" },
          { n: 3, t: "Configure webhook endpoint" },
          { n: 4, t: "Deploy to Vercel" },
        ].map((step) => (
          <div class="flex items-center gap-3">
            <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md text-xs font-medium bg-[var(--surface)] text-[var(--muted)]">
              {step.n}
            </div>
            <span class="text-sm">{step.t}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</DashboardLayout>
