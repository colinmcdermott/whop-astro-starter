---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import { getSession, hasMinimumPlan } from "@/lib/auth";
import { getPlansConfig } from "@/lib/config";
import { DEFAULT_PLAN, PLAN_KEYS } from "@/lib/constants";
import type { PlanKey } from "@/lib/constants";

export const prerender = false;

const session = await getSession(Astro.cookies);
if (!session) {
  return Astro.redirect("/login");
}

const plans = getPlansConfig();
const planConfig = plans[session.plan] ?? plans[DEFAULT_PLAN];
const nextPlanKey = PLAN_KEYS[PLAN_KEYS.indexOf(session.plan) + 1] as PlanKey | undefined;
---

<DashboardLayout title="Dashboard" session={session}>
  <div class="mx-auto max-w-4xl space-y-6">
    <!-- Welcome -->
    <div class="animate-slide-up">
      <h1 class="text-lg font-semibold tracking-tight">
        Welcome back{session.name ? `, ${session.name}` : ""}
      </h1>
      <p class="mt-0.5 text-sm text-[var(--muted)]">
        Here's an overview of your account.
      </p>
    </div>

    <!-- Stats -->
    <div class="animate-slide-up delay-100 grid gap-px overflow-hidden rounded-xl border border-[var(--border)] bg-[var(--border)] sm:grid-cols-3">
      <div class="bg-[var(--card)] p-5">
        <p class="text-xs text-[var(--muted)]">Current Plan</p>
        <p class="mt-1 text-xl font-semibold tracking-tight capitalize">{planConfig.name}</p>
      </div>
      <div class="bg-[var(--card)] p-5">
        <p class="text-xs text-[var(--muted)]">Projects</p>
        <p class="mt-1 text-xl font-semibold tracking-tight" style="font-variant-numeric: tabular-nums">0 / 3</p>
      </div>
      <div class="bg-[var(--card)] p-5">
        <p class="text-xs text-[var(--muted)]">Storage</p>
        <p class="mt-1 text-xl font-semibold tracking-tight" style="font-variant-numeric: tabular-nums">0 GB</p>
      </div>
    </div>

    <!-- Reactivate banner for users with pending cancellation -->
    {session.cancelAtPeriodEnd && session.plan !== DEFAULT_PLAN && (
      <div class="animate-slide-up delay-200 rounded-xl border border-amber-200 dark:border-amber-900/30 bg-amber-50 dark:bg-amber-900/10 p-5">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h3 class="text-sm font-semibold text-amber-800 dark:text-amber-200">Your subscription is ending</h3>
            <p class="mt-1 text-xs text-amber-700 dark:text-amber-300/80">
              Your plan will be downgraded at the end of the billing period. Reactivate to keep your access.
            </p>
          </div>
          <button
            id="reactivate-banner-btn"
            class="shrink-0 rounded-lg bg-amber-600 px-3 py-1.5 text-xs font-medium text-white transition-opacity hover:opacity-80"
          >
            Reactivate
          </button>
        </div>
      </div>
    )}

    <!-- Upgrade banner for free users -->
    {session.plan === DEFAULT_PLAN && (
      <div class="animate-slide-up delay-200 rounded-xl border border-[var(--accent)]/20 bg-[var(--accent)]/5 p-5">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h3 class="text-sm font-semibold">Upgrade your plan</h3>
            <p class="mt-1 text-xs text-[var(--muted)]">
              Get more projects, priority support, and advanced features.
            </p>
          </div>
          <a href="/pricing" class="shrink-0 rounded-lg bg-[var(--accent)] px-3 py-1.5 text-xs font-medium text-[var(--accent-foreground)] transition-opacity hover:opacity-80">
            View Plans
          </a>
        </div>
      </div>
    )}

    <!-- Plan features -->
    <div class="animate-slide-up delay-200 rounded-xl border border-[var(--border)] bg-[var(--card)] p-5">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h3 class="text-sm font-semibold">{planConfig.name} Plan</h3>
          <p class="mt-0.5 text-xs text-[var(--muted)]">{planConfig.description}</p>
        </div>
        {nextPlanKey && (
          <a href="/pricing" class="shrink-0 rounded-lg border border-[var(--border)] px-3 py-1.5 text-xs font-medium transition-colors hover:bg-[var(--surface)]">
            View Plans
          </a>
        )}
      </div>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
        {planConfig.features.map((feature) => (
          <li class="flex items-start gap-2 text-xs text-[var(--muted)]">
            <svg class="h-3.5 w-3.5 text-emerald-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span>{feature}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Plan-gated content: Pro features -->
    {hasMinimumPlan(session.plan, "pro" as PlanKey) ? (
      <div class="animate-slide-up delay-300 rounded-xl border border-[var(--border)] bg-[var(--card)] p-5">
        <h3 class="text-sm font-semibold">API Access</h3>
        <p class="mt-1 text-xs text-[var(--muted)]">
          Replace this with your API dashboard, key management, or any Pro-only feature.
        </p>
        <div class="mt-4 rounded-lg bg-[var(--surface)] p-3 font-mono text-xs text-[var(--muted)]">
          <span class="text-emerald-500">GET</span> /api/v1/data <span class="opacity-60">&rarr; 200 OK</span>
        </div>
      </div>
    ) : (
      <div class="animate-slide-up delay-300 rounded-xl border border-dashed border-[var(--border)] bg-[var(--card)] p-5">
        <div class="flex items-start justify-between gap-4">
          <div>
            <div class="flex items-center gap-2">
              <svg class="h-4 w-4 text-[var(--muted)]" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
              </svg>
              <h3 class="text-sm font-semibold text-[var(--muted)]">API Access</h3>
            </div>
            <p class="mt-1 text-xs text-[var(--muted)]">
              Upgrade to Pro to unlock API access and dedicated support.
            </p>
          </div>
          <a href="/pricing" class="shrink-0 rounded-lg border border-[var(--border)] px-3 py-1.5 text-xs font-medium transition-colors hover:bg-[var(--surface)]">
            Upgrade
          </a>
        </div>
      </div>
    )}

    <!-- Activity feed (placeholder) -->
    <div class="animate-slide-up delay-400 rounded-xl border border-[var(--border)] bg-[var(--card)] p-5">
      <h3 class="text-sm font-semibold">Recent Activity</h3>
      <div class="mt-4 space-y-3">
        <div class="flex items-start gap-3">
          <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-emerald-500/10 text-emerald-500">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0" />
            </svg>
          </div>
          <div>
            <p class="text-xs">Signed in via Whop OAuth</p>
            <p class="text-[10px] text-[var(--muted)]">Just now</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-[var(--accent)]/10 text-[var(--accent)]">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div>
            <p class="text-xs">Account created</p>
            <p class="text-[10px] text-[var(--muted)]">Just now</p>
          </div>
        </div>
      </div>
      <p class="mt-4 text-[10px] text-[var(--muted)]">Replace this feed with real events from your database.</p>
    </div>

    <!-- Getting started -->
    <div class="animate-slide-up delay-500 rounded-xl border border-[var(--border)] bg-[var(--card)] p-6">
      <h2 class="text-sm font-semibold">Get started</h2>
      <p class="mt-1 text-xs text-[var(--muted)] leading-relaxed">
        Replace this with your product. Auth, payments, and webhooks are ready.
      </p>

      <div class="mt-5 space-y-2.5">
        {[
          { n: 1, t: "Customize this dashboard" },
          { n: 2, t: "Set up your Whop plans" },
          { n: 3, t: "Configure webhook endpoint" },
          { n: 4, t: "Deploy to Vercel" },
        ].map((step) => (
          <div class="flex items-center gap-3">
            <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md text-xs font-medium bg-[var(--surface)] text-[var(--muted)]">
              {step.n}
            </div>
            <span class="text-sm">{step.t}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  // Reactivate banner
  const reactivateBtn = document.getElementById("reactivate-banner-btn");
  reactivateBtn?.addEventListener("click", async () => {
    reactivateBtn.textContent = "Reactivating...";
    const res = await fetch("/api/billing/uncancel", { method: "POST" });
    if (res.ok) {
      window.location.reload();
    } else {
      reactivateBtn.textContent = "Failed — try again";
    }
  });
</script>
