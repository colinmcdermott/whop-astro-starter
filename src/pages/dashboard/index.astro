---
import Layout from "@/layouts/Layout.astro";
import { getSession } from "@/lib/auth";

export const prerender = false;

const session = await getSession(Astro.cookies);
if (!session) {
  return Astro.redirect("/login");
}
---

<Layout title="Dashboard">
  <div class="max-w-4xl mx-auto px-6 py-12">
    <div class="flex items-center justify-between mb-10">
      <h1 class="text-2xl font-semibold">Dashboard</h1>
      <div class="flex items-center gap-4">
        <span class="text-sm text-[var(--muted)]">{session.email}</span>
        <a href="/api/auth/logout" class="text-sm text-red-500 hover:text-red-600 transition-colors">
          Sign out
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
      <div class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-6">
        <p class="text-xs uppercase text-[var(--muted)] mb-1">Plan</p>
        <p class="text-2xl font-semibold capitalize">{session.plan}</p>
      </div>
      <div class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-6">
        <p class="text-xs uppercase text-[var(--muted)] mb-1">Name</p>
        <p class="text-2xl font-semibold">{session.name || "—"}</p>
      </div>
      <div class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-6">
        <p class="text-xs uppercase text-[var(--muted)] mb-1">Role</p>
        <p class="text-2xl font-semibold">{session.isAdmin ? "Admin" : "Member"}</p>
      </div>
    </div>

    <div class="bg-[var(--card)] border border-[var(--border)] rounded-xl p-6">
      <h2 class="font-semibold mb-3">Start building</h2>
      <p class="text-sm text-[var(--muted)] leading-relaxed">
        This template uses <a href="https://www.npmjs.com/package/whop-kit" class="text-[var(--accent)] hover:underline">whop-kit</a> for
        authentication, session management, and subscription handling — the same library as the Next.js starter.
        Built with Astro for a content-first, fast-by-default experience.
      </p>
    </div>
  </div>
</Layout>
