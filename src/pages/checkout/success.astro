---
import Layout from "@/layouts/Layout.astro";
import { getSession } from "@/lib/auth";
import { getPlansConfig } from "@/lib/config";
import { PLAN_KEYS, type PlanKey } from "@/lib/constants";

export const prerender = false;

const planParam = Astro.url.searchParams.get("plan");
const session = await getSession(Astro.cookies);

const planKey = planParam && PLAN_KEYS.includes(planParam as PlanKey) ? (planParam as PlanKey) : null;

let planName: string | null = null;
if (planKey) {
  const plans = getPlansConfig();
  const config = plans[planKey];
  if (config) planName = config.name;
}

const isSignedIn = !!session;
---

<Layout title="Welcome">
  <div class="flex min-h-screen items-center justify-center px-4">
    <div class="w-full max-w-sm text-center animate-slide-up">
      <div class="mx-auto mb-5 flex h-12 w-12 items-center justify-center rounded-full bg-emerald-500/10">
        <svg class="h-6 w-6 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
        </svg>
      </div>

      <h1 class="text-lg font-semibold tracking-tight">You're all set!</h1>

      {planName ? (
        <p class="mt-2 text-sm text-[var(--muted)]">
          You're now on the <span class="font-medium text-[var(--foreground)]">{planName}</span> plan.
        </p>
      ) : (
        <p class="mt-2 text-sm text-[var(--muted)]">Your account is ready to go.</p>
      )}

      {isSignedIn ? (
        <a
          href="/dashboard"
          class="mt-7 inline-block rounded-lg bg-[var(--accent)] px-6 py-2.5 text-sm font-medium text-[var(--accent-foreground)] transition-opacity hover:opacity-80"
        >
          Go to Dashboard
        </a>
      ) : (
        <Fragment>
          <p class="mt-5 text-xs text-[var(--muted)]">
            Sign in to access your dashboard and manage your subscription.
          </p>
          <a
            href="/api/auth/login"
            class="mt-3 inline-block rounded-lg bg-[var(--accent)] px-6 py-2.5 text-sm font-medium text-[var(--accent-foreground)] transition-opacity hover:opacity-80"
          >
            Sign in
          </a>
        </Fragment>
      )}
    </div>
  </div>
</Layout>
