---
import Layout from "@/layouts/Layout.astro";
import AppLogo from "@/components/AppLogo.astro";
import { CheckoutForm } from "@/components/checkout/CheckoutForm";
import { getSession } from "@/lib/auth";
import { getPlansConfig } from "@/lib/config";
import { PLAN_KEYS, type PlanKey, type BillingInterval } from "@/lib/constants";

export const prerender = false;

const planParam = Astro.url.searchParams.get("plan");
const intervalParam = Astro.url.searchParams.get("interval");

const planKey: PlanKey | null =
  planParam && PLAN_KEYS.includes(planParam as PlanKey) ? (planParam as PlanKey) : null;
const interval: BillingInterval = intervalParam === "monthly" ? "monthly" : "yearly";

const [plans, session] = await Promise.all([getPlansConfig(), getSession(Astro.cookies)]);

const plan = planKey ? (plans[planKey] ?? null) : null;
const whopPlanId = plan
  ? interval === "yearly" ? plan.whopPlanIdYearly : plan.whopPlanId
  : "";

const isValid = !!(plan && whopPlanId && planKey);
const price = plan ? (interval === "yearly" ? plan.priceYearly : plan.priceMonthly) : 0;
---

<Layout title="Checkout">
  <div class="flex min-h-screen flex-col">
    <header class="flex items-center justify-between border-b border-[var(--border)] px-6 py-4">
      <a href="/"><AppLogo /></a>
      <a href="/pricing" class="text-xs text-[var(--muted)] transition-colors hover:text-[var(--foreground)]">
        Back to Pricing
      </a>
    </header>

    {!isValid ? (
      <div class="flex flex-1 items-center justify-center px-4">
        <div class="w-full max-w-xs text-center">
          <h1 class="text-sm font-semibold">Invalid Plan</h1>
          <p class="mt-2 text-xs text-[var(--muted)]">
            The plan you selected doesn't exist or hasn't been configured.
          </p>
          <a
            href="/pricing"
            class="mt-6 inline-block rounded-lg border border-[var(--border)] px-5 py-2 text-sm font-medium transition-colors hover:bg-[var(--surface)]"
          >
            Back to Pricing
          </a>
        </div>
      </div>
    ) : (
      <CheckoutForm
        client:load
        planName={plan.name}
        planKey={planKey}
        planFeatures={[...plan.features]}
        whopPlanId={whopPlanId}
        interval={interval}
        price={price}
        userEmail={session?.email ?? null}
        userName={session?.name ?? null}
      />
    )}
  </div>
</Layout>
